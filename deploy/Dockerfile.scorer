# Pronunciation scorer, CPU only. Build context is the repository root.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models NLTK_DATA=/usr/share/nltk_data \
    SUPERTONIC_CACHE_DIR=/models/supertonic3 HF_HUB_DISABLE_XET=1
WORKDIR /app
COPY services/scorer/requirements.txt services/scorer/requirements-ml.txt ./
RUN pip install -r requirements.txt \
 && pip install "torch==$(sed -n 's/^torch==//p' requirements-ml.txt)" --index-url https://download.pytorch.org/whl/cpu \
 && pip install -r requirements-ml.txt \
 && python -m nltk.downloader -d "$NLTK_DATA" cmudict
COPY services/scorer/app app
RUN useradd --uid 1000 --no-create-home scorer && mkdir -p /models && chown scorer /models
USER scorer
CMD ["uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8788"]
