# Copy to deploy/.env (it is git-ignored) and fill in.

# Domain the app lives on, without https://, e.g. kquiz.example.com
DOMAIN=

# Long random string, generate with: openssl rand -hex 32
# The same value goes into the Cloudflare Transform Rule header x-kquiz-origin.
ORIGIN_SECRET=

# Where data and the Cloudflare origin certificate live on the server.
# KQUIZ_DATA=/srv/kquiz/data
# KQUIZ_CERTS=/srv/kquiz/certs
