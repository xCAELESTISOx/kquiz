# Copy to deploy/.env (it is git-ignored) and fill in.

# Domain the app lives on, without https://, e.g. kquiz.example.com
DOMAIN=

# E-mail for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=

# Long random string, generate with: openssl rand -hex 32
# Caddy adds it to every request it forwards; the API refuses requests without it.
ORIGIN_SECRET=

# One-time code for binding the first passkey. If empty, the API prints a random one to its log.
# SETUP_CODE=

# Where data lives on the server.
# KQUIZ_DATA=/srv/kquiz/data
