# API: Node 22, Hono, SQLite. Build context is the repository root.
# The full image has python3, make and g++ in case better-sqlite3 has to compile.
FROM node:22-bookworm AS build
RUN corepack enable
WORKDIR /src
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter @kquiz/api...
COPY apps/api apps/api
RUN pnpm --filter @kquiz/api build \
 && pnpm --filter @kquiz/api deploy --legacy --prod /out \
 && rm -rf /out/src

FROM node:22-bookworm-slim
ENV NODE_ENV=production HOST=127.0.0.1 PORT=8787 DATABASE_PATH=/data/kquiz.db
WORKDIR /app
COPY --from=build /out .
RUN mkdir -p /data && chown node:node /data
USER node
CMD ["node", "dist/index.js"]
