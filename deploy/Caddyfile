# Only Cloudflare reaches this server (firewall + ORIGIN_SECRET in the API).
# TLS between Cloudflare and Caddy uses a Cloudflare Origin Certificate, so no ACME and no port 80.
{
	admin off
	auto_https off
	persist_config off
}

{$DOMAIN}:443 {
	tls /certs/origin.pem /certs/origin.key

	# The API caps bodies at 1 MB itself; this stops bigger ones before they reach Node.
	request_body {
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	log {
		output stdout
		format json
	}

	@backend path /api/* /mcp /mcp/* /oauth/* /.well-known/*
	handle @backend {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /srv
		encode zstd gzip
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		@notAsset not path /assets/*
		header @notAsset Cache-Control "no-cache"
		# SPA: /login and any other client path get index.html (the OAuth consent links to /login).
		try_files {path} /index.html
		file_server
	}
}
